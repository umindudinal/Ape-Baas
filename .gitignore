# ==========================================
# Root .gitignore - Home Service Project
# ==========================================

# ------------------------------------------
# Environment Variables & Secrets (CRITICAL)
# ------------------------------------------
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.cert
*.p12
*.pfx
*.keystore
*.jks

# Firebase & Cloud Service Keys
*firebase-adminsdk*.json
*service-account*.json
firebase-service-account.json
GoogleService-Info.plist

# ------------------------------------------
# Operating System & IDE Files
# ------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# JetBrains / Android Studio / IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/
.fleet/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------------------------
# Node.js / JavaScript (Backend, Admin, Web)
# ------------------------------------------
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Build Outputs
dist/
*/dist/
build/
*/build/
out/
*/out/
.cache/
*/.cache/
.vite/
*/.vite/
.eslintcache

# Logs & Temporary Files
logs/
*.log
*.tmp
*.temp
*.swp
*~

# ------------------------------------------
# Flutter / Dart (mobile_app)
# ------------------------------------------
.dart_tool/
*/.dart_tool/
.flutter-plugins
*/.flutter-plugins
.flutter-plugins-dependencies
*/.flutter-plugins-dependencies
.packages
*/.packages
.pub-cache/
*/.pub-cache/
.pub/
*/.pub/
pubspec-overrides.yaml

# Flutter Android
android/.gradle/
android/captures/
android/local.properties
android/GeneratedPluginRegistrant.java
android/.kotlin/
*.apk
*.aab
*.dex
*.class

# Flutter iOS
ios/Flutter/.last_build_id
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/app.flx
ios/Flutter/app.zip
ios/Flutter/flutter_assets/
ios/Flutter/ephemeral/
ios/Pods/
ios/.symlinks/
ios/Runner.xcodeproj/project.xcworkspace/xcuserdata/
ios/Runner.xcworkspace/xcuserdata/

# Flutter Windows / macOS / Linux
windows/flutter/ephemeral/
macos/Flutter/ephemeral/
linux/flutter/ephemeral/
